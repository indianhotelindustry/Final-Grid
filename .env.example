# ============================================================
#  Hotel PMS — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================

# ----- Core Flask -----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Set to 'development' only on your local dev machine
# Leave blank or set to 'production' for live use
FLASK_ENV=production

# ----- Database -----
# Default: leave blank or omit — the app will use a local SQLite database
# at instance/pms.db (best for offline per-hotel deployment).
#
# For PostgreSQL (requires a running server):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/hotel_pms
#
# For SQLite (explicit):
# DATABASE_URL=sqlite:///instance/pms.db

# ----- Application Port -----
PORT=5000

# ----- LAN Access (opt-in) -----
# 0 (default) = server binds to 127.0.0.1 only — single-machine install.
# 1           = server binds to 0.0.0.0 — reachable from other machines on
#               the hotel LAN. Requires an inbound firewall rule on the PORT
#               above. Use enable_lan.bat (ships with installer) to open it,
#               or run: netsh advfirewall firewall add rule name="SukoonPMS"
#               dir=in action=allow protocol=TCP localport=5000
#
# Multi-user note: SQLite serialises writes at the database level, so LAN
# access is safe for a small hotel (front desk + manager + housekeeping)
# but will serialise under heavy concurrent writes. Switch to PostgreSQL
# for 10+ concurrent operators.
ALLOW_LAN=0

# ----- Hotel Info -----
HOTEL_NAME=My Hotel
HOTEL_PHONE=011-XXXXXXXX

# ----- Phase 2: Channel Manager Webhook -----
# The webhook API key is auto-generated on first run.
# Check Masters → Settings → webhook_api_key to view it.
# You can override it here if you want a specific key:
# WEBHOOK_API_KEY=your_custom_api_key_here

# ----- WhatsApp Notifications (UltraMSG) -----
# Optional — leave blank for offline deployment without notifications.
# Sign up at https://ultramsg.com and connect your WhatsApp Business number.
# Failed sends are queued and retried automatically when connectivity returns.
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=

# WhatsApp number to receive front-desk alerts for new bookings
# Format: country code + number, no + or spaces (e.g. 919876543210 for India)
FRONTDESK_WHATSAPP=

# ----- Email Notifications (SMTP) -----
# Optional — leave blank for offline deployment without email.
# Failed sends are queued and retried automatically when connectivity returns.
# For Gmail: enable 2FA, then create an App Password at
# myaccount.google.com/security → App Passwords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# For Outlook/Office365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

# ----- Guest Portal (Pre-Check-In) -----
# Public URL used in WhatsApp pre-check-in links sent to guests.
# Set this to your Cloudflare Tunnel URL once it is running.
# Without it, links default to http://localhost:5000 (only works on the same machine).
# PUBLIC_BASE_URL=https://your-tunnel-name.trycloudflare.com

# ----- Cloudflare Tunnel -----
# Optional — only needed if you want external access (OTA sync, guest portal).
# Set after creating tunnel: cloudflared tunnel create hotel-pms
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# ----- AI Insights (Module 7 — Gemini) -----
# Optional — leave blank for offline deployment. Without a key, the AI
# Insights panel on the dashboard falls back to a deterministic rule-based
# version that runs locally with no network calls.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override. Default is gemini-2.0-flash (fast + cheap).
# GEMINI_MODEL=gemini-2.0-flash
